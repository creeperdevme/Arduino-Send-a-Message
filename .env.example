# Arduino serial port (e.g. COM3 on Windows or /dev/ttyACM0 on Linux/macOS)
ARDUINO_PORT=COM3

# Serial baud rate
ARDUINO_BAUD=9600

# FastAPI app binding settings
APP_HOST=0.0.0.0
APP_PORT=3000

# Maximum characters per line for the LCD display
MAX_LINE_LENGTH=16

# Delay after opening the serial port before sending data
CONNECT_DELAY_SECONDS=2
